{
  "extends": "../../default.json",
  "name": "kiba",
  "description": "TDC KIBA kinase DTI benchmark, binarised at KIBA score >= 12.1. Diagnosis-generalisation probe (NOT a competitive-affinity claim). See docs/BENCHMARK_INTEGRATION_PLAN.md.",

  "data": {
    "csv_path": "reactionDataFiltering/data/interim/benchmarks/kiba/pairs.csv",
    "seq_csv":  "reactionDataFiltering/data/interim/benchmarks/kiba/sequences.csv",
    "esm2_dir": "reactionDataFiltering/data/interim/benchmarks/kiba/esm2_embeddings",
    "val_frac": 0.15,
    "test_frac": 0.15
  },

  "dataset_meta": {
    "source": "TDC DTI('KIBA')",
    "task": "kinase KIBA-score affinity, binarised",
    "binarisation": "label = 1 if KIBA score >= 12.1",
    "smiles_col": "substrate_smiles",
    "protein_col": "uniprot",
    "label_col": "label",
    "split": "project protein-split (BRENDADataConfig, seed 42) applied by loader",
    "role": "diagnosis-generalisation (beyond enzyme-substrate)"
  }
}
